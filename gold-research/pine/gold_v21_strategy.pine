//@version=6
// GOLD v2.1 CANDIDATE — trend-pullback strategy for XAUUSD on the 15-minute chart.
// Source rules: gold-research/GOLD_PLAYBOOK_v2_CANDIDATE.md (v2.1 = no breakout trigger, no momentum vote, window 07:00-15:45 UTC)
// and gold-research/ACCOUNT_RULES.md (0.5 % risk, hard stop always, daily/weekly stops).
// Status: UNVALIDATED. Backtest INCONCLUSIVE on HistData. This script is for Aayan's own TradingView backtests.
//
// HOW TO USE
//   1. Open XAUUSD (FOREX.com) on the 15-minute chart. Add this as a strategy.
//   2. Strategy Tester > Settings: initial capital 50000, commission 0.15 per contract (≈ 0.30 USD/oz round trip, the
//      spread the script cannot see), slippage 5 ticks (0.05 USD). Turn on "Use bar magnifier" if your plan has it.
//   3. Order size is computed by the script (risk % of equity ÷ stop distance), in ounces. 100 oz = 1.00 lot.
//   4. Read the Properties tab, then List of Trades. Compare periods separately: 2021-01 → 2024-06, 2024-07 → 2025-08,
//      2025-09 → today. Never tune on all three at once.
//
// WHAT IT CANNOT DO: read the news calendar (set the blackout inputs by hand on news days), see 1-minute lows inside a
// 15-minute bar before the fill (stops use 15-minute lows), or know your broker's live spread.
strategy("Gold v2.1 Pullback (Holy Grail + daily bias)", shorttitle="Gold v2.1", overlay=true, pyramiding=0,
     initial_capital=50000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.15, slippage=5,
     calc_on_every_tick=false, process_orders_on_close=false, max_bars_back=600)

// ───────────────────────────── Inputs ─────────────────────────────
gTrend   = "Trend and setup (L1/L3)"
adxLen    = input.int(14, "ADX / DI length", minval=5, group=gTrend)
adxThr    = input.float(30.0, "ADX armed threshold", step=1, group=gTrend)
adxLook   = input.int(10, "Bars back for 'ADX rising above threshold'", minval=1, group=gTrend)
adxCancel = input.float(25.0, "Cancel pending if ADX falls below", step=1, group=gTrend)
emaLen    = input.int(20, "EMA length", minval=2, group=gTrend)
atrLen    = input.int(14, "ATR length", minval=2, group=gTrend)
useBias   = input.bool(true, "Daily bias filter (close vs SMA200 on D1, previous day)", group=gTrend)
smaLen    = input.int(200, "Daily SMA length for bias", minval=20, group=gTrend)

gEntry   = "Entry, stop, target (L4/L5)"
entryOff  = input.float(0.10, "Entry offset beyond touch bar (USD)", step=0.05, group=gEntry)
bufMin    = input.float(0.30, "Stop buffer minimum (USD)", step=0.05, group=gEntry)
bufAtr    = input.float(0.10, "Stop buffer × ATR", step=0.05, group=gEntry)
deepAtr   = input.float(0.5, "Cancel if close beyond EMA by × ATR (deep break)", step=0.1, group=gEntry)
tgtLook   = input.int(20, "Target = extreme of last N bars at first touch", minval=5, group=gEntry)
capAtr    = input.float(1.0, "Cap target at prior-day H/L if beyond it by × ATR (0 = off)", step=0.5, group=gEntry)
minRR     = input.float(1.5, "Minimum reward/risk at placement", step=0.1, group=gEntry)
rearm     = input.bool(true, "Re-arm on later touch bars", group=gEntry)
expiryN   = input.int(4, "Pending expires after N bars", minval=1, group=gEntry)
stopSan   = input.float(0.6, "Skip if stop distance > × daily ATR (0 = off)", step=0.1, group=gEntry)
usePartial= input.bool(true, "50 % off at T1, stop to breakeven, trail remainder", group=gEntry)
partPct   = input.float(50, "Partial %", minval=10, maxval=90, step=10, group=gEntry)
bePlus    = input.float(0.10, "Breakeven offset after T1 (USD)", step=0.05, group=gEntry)
trailMult = input.float(3.0, "Chandelier trail × ATR on remainder", step=0.5, group=gEntry)

gTime    = "Session gates (L0), UTC"
sigStartH = input.int(7,  "Signal window start hour", minval=0, maxval=23, group=gTime)
sigStartM = input.int(0,  "Signal window start minute", minval=0, maxval=59, group=gTime)
sigEndH   = input.int(15, "Signal window end hour", minval=0, maxval=23, group=gTime)
sigEndM   = input.int(45, "Signal window end minute", minval=0, maxval=59, group=gTime)
cutH      = input.int(16, "Cancel pending at hour", minval=0, maxval=23, group=gTime)
cutM      = input.int(0,  "Cancel pending at minute", minval=0, maxval=59, group=gTime)
flatH     = input.int(20, "Force flat at hour", minval=0, maxval=23, group=gTime)
flatM     = input.int(45, "Force flat at minute (bar OPEN time; fills next bar open)", minval=0, maxval=59, group=gTime)
newsOn    = input.bool(false, "Manual news blackout today (no new orders in window)", group=gTime)
newsH     = input.int(13, "Blackout centre hour", minval=0, maxval=23, group=gTime)
newsM     = input.int(30, "Blackout centre minute", minval=0, maxval=59, group=gTime)
newsHalf  = input.int(5,  "Blackout half-width (minutes)", minval=1, maxval=60, group=gTime)

gRisk    = "Risk and sizing (L6, ACCOUNT_RULES.md)"
riskPct   = input.float(0.5, "Risk per trade, % of equity", step=0.1, group=gRisk)
maxDay    = input.int(3, "Max entries per session day", minval=1, group=gRisk)
dayStopR  = input.float(-2.0, "Daily stop (closed R)", step=0.5, group=gRisk)
wkStopR   = input.float(-4.0, "Weekly stop (closed R)", step=0.5, group=gRisk)
consecN   = input.int(3, "Daily stop after N consecutive losses", minval=1, group=gRisk)
qtyStep   = input.float(1.0, "Quantity step (oz). 1 = whole ounces; 0.01-lot brokers = 1 oz", step=1, group=gRisk)

gPlot    = "Display"
showLvls  = input.bool(true, "Show entry / stop / target", group=gPlot)

// ───────────────────────────── Indicators ─────────────────────────────
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
ema  = ta.ema(close, emaLen)
atr  = ta.atr(atrLen)
risingAbove = adx > adxThr and adx > adx[1]
armed    = adx > adxThr and ta.barssince(risingAbove) <= adxLook
longDir  = diPlus > diMinus
touch    = low <= ema and high >= ema

// Previous completed daily bar (non-repainting: value of the bar that closed before the current intraday bar)
dClose = request.security(syminfo.tickerid, "D", close[1],  lookahead=barmerge.lookahead_on)
dSma   = request.security(syminfo.tickerid, "D", ta.sma(close, smaLen)[1], lookahead=barmerge.lookahead_on)
dHigh  = request.security(syminfo.tickerid, "D", high[1],   lookahead=barmerge.lookahead_on)
dLow   = request.security(syminfo.tickerid, "D", low[1],    lookahead=barmerge.lookahead_on)
dAtr   = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead=barmerge.lookahead_on)
biasLong  = not useBias or (not na(dSma) and dClose > dSma)
biasShort = not useBias or (not na(dSma) and dClose < dSma)

// ───────────────────────────── Time gates ─────────────────────────────
mod      = hour(time, "UTC") * 60 + minute(time, "UTC")          // bar OPEN time, minutes of day
sigLo    = sigStartH * 60 + sigStartM
sigHi    = sigEndH * 60 + sigEndM
cutMin   = cutH * 60 + cutM
flatMin  = flatH * 60 + flatM
inWindow = mod >= sigLo and mod <= sigHi
newsMin  = newsH * 60 + newsM
inNews   = newsOn and math.abs(mod - newsMin) <= newsHalf
sessDay  = math.floor((time + 3600000) / 86400000)                // session day: 23:00 UTC → 23:00 UTC
weekKey  = year(time, "UTC") * 100 + weekofyear(time, "UTC")

// ───────────────────────────── State ─────────────────────────────
var int   pendSide   = 0       // 0 none, 1 long, -1 short
var float pendLevel  = na
var float pendTarget = na
var float pendBuf    = na
var float seqLow     = na
var float seqHigh    = na
var int   firstBar   = na
var int   lastTouch  = na
var float initStop   = na
var float runStop    = na
var float t1Level    = na
var float hhSince    = na
var float llSince    = na
var float entryQty   = na
var float riskPerOz  = na
var bool  t1Done     = false
var int   dayKey     = -1
var int   wkKey      = -1
var int   tradesDay  = 0
var float dayR       = 0.0
var float wkR        = 0.0
var int   consec     = 0
var bool  dayHalt    = false
var bool  wkHalt     = false
var int   closedPrev = 0

inPos = strategy.position_size != 0

// new session day / week
if sessDay != dayKey
    dayKey   := sessDay
    tradesDay := 0
    dayR     := 0.0
    consec   := 0
    dayHalt  := false
if weekKey != wkKey
    wkKey  := weekKey
    wkR    := 0.0
    wkHalt := false

// ───────────────────────────── Closed-trade accounting (R) ─────────────────────────────
if strategy.closedtrades > closedPrev
    for i = closedPrev to strategy.closedtrades - 1
        p = strategy.closedtrades.profit(i)
        r = na(riskPerOz) or na(entryQty) or entryQty == 0 ? 0.0 : p / (riskPerOz * entryQty)
        dayR  += r
        wkR   += r
        consec := p <= 0 ? consec + 1 : 0
    closedPrev := strategy.closedtrades
    if consec >= consecN or dayR <= dayStopR
        dayHalt := true
    if wkR <= wkStopR
        wkHalt := true

// position just closed → clear
if not inPos and inPos[1]
    initStop := na
    runStop  := na
    t1Level  := na
    t1Done   := false
    hhSince  := na
    llSince  := na

// ───────────────────────────── Forced flat ─────────────────────────────
if inPos and mod >= flatMin
    strategy.close_all(comment="time_exit")

// ───────────────────────────── Position management ─────────────────────────────
if inPos
    isLong = strategy.position_size > 0
    hhSince := na(hhSince) ? high : math.max(hhSince, high)
    llSince := na(llSince) ? low  : math.min(llSince, low)
    // detect partial fill
    if usePartial and not t1Done and math.abs(strategy.position_size) < entryQty - 1e-9
        t1Done := true
        be = isLong ? strategy.position_avg_price + bePlus : strategy.position_avg_price - bePlus
        runStop := isLong ? math.max(runStop, be) : math.min(runStop, be)
    if t1Done and trailMult > 0
        tr = isLong ? hhSince - trailMult * atr : llSince + trailMult * atr
        if isLong and tr > runStop and tr < low
            runStop := tr
        if not isLong and tr < runStop and tr > high
            runStop := tr
    if usePartial and not t1Done
        strategy.exit("T1",  from_entry=isLong ? "L" : "S", qty_percent=partPct, limit=t1Level, stop=initStop, comment_profit="T1", comment_loss="stop")
        strategy.exit("Run", from_entry=isLong ? "L" : "S", stop=runStop, comment_loss="stop")
    else if usePartial and t1Done
        strategy.exit("Run", from_entry=isLong ? "L" : "S", stop=runStop, comment_loss="trail/BE")
    else
        strategy.exit("X", from_entry=isLong ? "L" : "S", limit=t1Level, stop=initStop, comment_profit="target", comment_loss="stop")

// ───────────────────────────── Pending-order management (bar just closed) ─────────────────────────────
if not inPos and pendSide != 0
    // cut-off, news, cancellations, expiry
    deep = pendSide == 1 ? close < ema - deepAtr * atr : close > ema + deepAtr * atr
    if mod >= cutMin or inNews or deep or adx < adxCancel or bar_index >= lastTouch + expiryN or dayHalt or wkHalt
        strategy.cancel_all()
        pendSide := 0
    else
        seqLow  := math.min(seqLow, low)
        seqHigh := math.max(seqHigh, high)
        // re-arm on a later valid touch bar
        if rearm and armed and touch and (pendSide == 1) == longDir and inWindow
            if pendSide == 1
                pendLevel := high + entryOff
                stopEst = seqLow - pendBuf
                rr = (pendTarget - pendLevel) / (pendLevel - stopEst)
                if rr < minRR
                    strategy.cancel_all()
                    pendSide := 0
                else
                    lastTouch := bar_index
            else
                pendLevel := low - entryOff
                stopEst = seqHigh + pendBuf
                rr = (pendLevel - pendTarget) / (stopEst - pendLevel)
                if rr < minRR
                    strategy.cancel_all()
                    pendSide := 0
                else
                    lastTouch := bar_index
        if pendSide != 0
            // refresh the resting stop order and the stop/target that will apply on fill
            stopEst2 = pendSide == 1 ? seqLow - pendBuf : seqHigh + pendBuf
            riskPerOz := math.abs(pendLevel - stopEst2)
            qty = math.floor((strategy.equity * riskPct / 100) / riskPerOz / qtyStep) * qtyStep
            if qty >= qtyStep
                entryQty := qty
                initStop := stopEst2
                runStop  := stopEst2
                t1Level  := pendTarget
                if pendSide == 1
                    strategy.entry("L", strategy.long, qty=qty, stop=pendLevel, comment="buy stop")
                else
                    strategy.entry("S", strategy.short, qty=qty, stop=pendLevel, comment="sell stop")
            else
                strategy.cancel_all()
                pendSide := 0

// ───────────────────────────── New setup (Trigger A) ─────────────────────────────
canSignal = not inPos and pendSide == 0 and inWindow and not inNews and not dayHalt and not wkHalt and tradesDay < maxDay
if canSignal and armed and touch and not na(atr) and not na(adx)
    side = longDir ? 1 : -1
    allowed = side == 1 ? biasLong : biasShort
    if allowed
        buf = math.max(bufMin, bufAtr * atr)
        float level  = na
        float target = na
        float stopEst = na
        if side == 1
            level  := high + entryOff
            target := ta.highest(high, tgtLook)
            if capAtr > 0 and not na(dHigh) and target > dHigh + capAtr * atr and dHigh > level
                target := dHigh
            stopEst := low - buf
        else
            level  := low - entryOff
            target := ta.lowest(low, tgtLook)
            if capAtr > 0 and not na(dLow) and target < dLow - capAtr * atr and dLow < level
                target := dLow
            stopEst := high + buf
        risk = math.abs(level - stopEst)
        rr   = math.abs(target - level) / risk
        okSan = stopSan <= 0 or na(dAtr) or risk <= stopSan * dAtr
        if rr >= minRR and okSan
            pendSide   := side
            pendLevel  := level
            pendTarget := target
            pendBuf    := buf
            seqLow     := low
            seqHigh    := high
            firstBar   := bar_index
            lastTouch  := bar_index
            riskPerOz  := risk
            qty = math.floor((strategy.equity * riskPct / 100) / risk / qtyStep) * qtyStep
            if qty >= qtyStep
                entryQty := qty
                initStop := stopEst
                runStop  := stopEst
                t1Level  := target
                if side == 1
                    strategy.entry("L", strategy.long, qty=qty, stop=level, comment="buy stop")
                else
                    strategy.entry("S", strategy.short, qty=qty, stop=level, comment="sell stop")
            else
                pendSide := 0

// count entries per day
if inPos and not inPos[1]
    tradesDay += 1

// ───────────────────────────── Plots ─────────────────────────────
plot(ema, "EMA20", color=color.new(color.aqua, 0), linewidth=2)
bgcolor(useBias ? (biasLong ? color.new(color.green, 92) : biasShort ? color.new(color.red, 92) : na) : na, title="Daily bias")
plot(showLvls and (pendSide != 0 or inPos) ? (inPos ? strategy.position_avg_price : pendLevel) : na, "Entry", color=color.new(color.yellow, 0), style=plot.style_linebr)
plot(showLvls and (pendSide != 0 or inPos) ? (inPos ? runStop : (pendSide == 1 ? seqLow - pendBuf : seqHigh + pendBuf)) : na, "Stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(showLvls and (pendSide != 0 or inPos) ? (inPos ? t1Level : pendTarget) : na, "Target", color=color.new(color.lime, 0), style=plot.style_linebr)
plotshape(armed and touch and inWindow and not inPos, "Touch bar in trend", style=shape.circle, location=location.belowbar, color=color.new(color.orange, 0), size=size.tiny)
plotchar(dayHalt or wkHalt, "Daily/weekly stop active", char="■", location=location.top, color=color.new(color.red, 0), size=size.tiny)
